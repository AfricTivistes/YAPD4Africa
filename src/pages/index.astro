---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import Icon from "@/components/Icon.astro";
import Img from "@/components/Img.astro";
import PostCard from "@/components/PostCard.astro";
import PartnersStrip from "@/components/PartnersStrip.astro";
import ImpactBand from "@/components/ImpactBand.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import heroImage from "@/assets/images/home/about.jpg";
import lawImage from "@/assets/images/projects/law.jpg";
import founder from "@/assets/images/staff/idris-bilyaminu.jpg";
import { approach, founderQuote, mission, recognitions, vision } from "@/data/content";
import { getPartners, getPosts, getProjects, getReports, getSettings } from "@/lib/content";

const [settings, posts, partners, projects, reports] = await Promise.all([
  getSettings(),
  getPosts(),
  getPartners(),
  getProjects(),
  getReports(),
]);
const programs = projects.filter((p) => p.category === "homegrown").slice(0, 6);
const latestPosts = posts.slice(0, 3);
const featuredReport = reports.find((r) => r.type === "annual");
const headline = settings.impact[0];
---

<BaseLayout image={heroImage}>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-sand">
    <div class="pointer-events-none absolute -top-32 -right-32 h-96 w-96 rounded-full bg-accent/20 blur-3xl" aria-hidden="true">
    </div>
    <div class="container-site relative grid items-center gap-12 py-14 md:py-20 lg:grid-cols-[1.1fr_1fr] lg:gap-16">
      <div>
        <p class="eyebrow mb-5">
          <span class="h-px w-8 bg-brand" aria-hidden="true"></span>
          Pan-African · Youth-led · Since 2017
        </p>
        <h1 class="text-4xl leading-[1.08] md:text-5xl lg:text-6xl">
          Advancing social development and empowering African <span class="text-brand">grassroots</span> communities
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-gray-600 md:text-xl">
          Through youth-led empowerment, inclusive governance and advocacy, we help citizens hold power to account and
          build the future they deserve.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/what-we-do" class="btn-primary px-7 py-3.5 shadow-lg shadow-brand/20">
            Explore our programs <Icon name="lucide:arrow-right" class="h-4 w-4" />
          </a>
          <a href="/support-us" class="btn-outline px-7 py-3.5">
            <Icon name="lucide:heart" class="h-4 w-4" /> Support our work
          </a>
        </div>
        <p class="mt-8 flex items-center gap-2 text-sm text-gray-600">
          <Icon name="lucide:award" class="h-5 w-5 shrink-0 text-accent-dark" />
          Recognized internationally in Germany (2024) and China (2025)
        </p>
      </div>

      <div class="relative mx-auto w-full max-w-md lg:max-w-none">
        <div class="overflow-hidden rounded-[2rem] shadow-2xl shadow-brand-deep/20">
          <Image
            src={heroImage}
            alt="YAPD4Africa team with community members by the river"
            class="aspect-[4/5] w-full object-cover"
            width={900}
            widths={[400, 640, 900]}
            sizes="(min-width: 1024px) 40vw, (min-width: 448px) 28rem, 100vw"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <div
          class="absolute -bottom-6 -left-4 hidden w-44 overflow-hidden rounded-2xl border-4 border-white shadow-xl sm:block md:-left-10 md:w-52"
        >
          <Image src={lawImage} alt="" class="aspect-square w-full object-cover" width={420} widths={[220, 420]} sizes="13rem" />
        </div>
        {
          headline && (
            <div class="absolute top-6 -right-2 rounded-2xl bg-white px-5 py-4 shadow-xl md:-right-6">
              <p class="font-display text-3xl font-bold text-brand">{headline.value}</p>
              <p class="text-sm font-medium text-gray-600">{headline.label.toLowerCase()}</p>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <ImpactBand impact={settings.impact} />

  <!-- About -->
  <section id="about" class="section bg-white">
    <div class="container-site grid gap-12 lg:grid-cols-2 lg:gap-20">
      <div>
        <SectionHeading eyebrow="Who we are" title="A youth-led movement for accountable, inclusive communities" />
        <div class="space-y-5 text-lg leading-relaxed text-gray-600" data-reveal>
          <p>
            Founded in 2017, the Connected Youth for Accountability, Peace and Development Initiative (YAPD4Africa) is a
            Pan-African, youth-led civil society organization headquartered in Kaduna, Nigeria.
          </p>
          <p>
            We work at the intersection of civic participation, technology and community development, equipping
            underserved communities with the knowledge, tools and data they need to defend their rights and drive their
            own development.
          </p>
        </div>
        <a href="/who-are-we" class="mt-8 inline-flex items-center gap-2 py-1 font-semibold text-brand hover:text-brand-dark">
          Our story and team <Icon name="lucide:arrow-right" class="h-4 w-4" />
        </a>
      </div>
      <div class="grid content-center gap-5">
        <div class="card flex gap-5 p-7" data-reveal>
          <span class="h-fit rounded-xl bg-brand/10 p-3 text-brand"><Icon name="lucide:rocket" class="h-7 w-7" /></span>
          <div>
            <h3 class="mb-2 text-xl">Our Mission</h3>
            <p class="leading-relaxed text-gray-600">{mission}</p>
          </div>
        </div>
        <div class="card flex gap-5 p-7" data-reveal>
          <span class="h-fit rounded-xl bg-accent/20 p-3 text-accent-dark"><Icon name="lucide:lightbulb" class="h-7 w-7" /></span>
          <div>
            <h3 class="mb-2 text-xl">Our Vision</h3>
            <p class="leading-relaxed text-gray-600">{vision}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Programs -->
  <section class="section bg-sand">
    <div class="container-site">
      <div class="flex flex-wrap items-end justify-between gap-x-6">
        <SectionHeading
          eyebrow="Our programs"
          title="Homegrown initiatives, built with communities"
          subtitle="From civic education to healthcare accountability, each program turns citizen voices into concrete change."
        />
        <a href="/what-we-do" class="btn-outline mb-10 md:mb-14">All programs <Icon name="lucide:arrow-right" class="h-4 w-4" /></a>
      </div>
      <div class="grid auto-rows-[18rem] gap-5 md:grid-cols-2 lg:grid-cols-3">
        {
          programs.map((project, i) => (
            <ProjectCard
              project={project}
              variant="overlay"
              class={i === 0 ? "md:col-span-2 lg:row-span-2" : undefined}
              sizes={i === 0 ? "(min-width: 768px) 66vw, 100vw" : "(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- Founder quote -->
  <section class="bg-brand-deep">
    <div class="container-site grid items-center gap-10 py-16 md:py-24 lg:grid-cols-[auto_1fr] lg:gap-16">
      <Image
        src={founder}
        alt={founderQuote.author}
        class="mx-auto aspect-square w-40 rounded-full border-4 border-accent object-cover object-top md:w-56"
        width={448}
        widths={[224, 448]}
        sizes="14rem"
      />
      <figure data-reveal>
        <Icon name="lucide:quote" class="mb-4 h-10 w-10 text-accent" />
        <blockquote class="font-display text-2xl leading-snug font-semibold text-white md:text-4xl">
          {founderQuote.text}
        </blockquote>
        <figcaption class="mt-6 text-white/80">
          <span class="font-semibold text-white">{founderQuote.author}</span> · {founderQuote.role}
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- Approach -->
  <section class="section bg-white">
    <div class="container-site">
      <SectionHeading
        eyebrow="How we work"
        title="The CARE-SD framework"
        subtitle="Six interconnected pillars guide every intervention, from identifying local needs to scaling community-led solutions."
        centered
      />
      <ol class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          approach.map((pillar) => (
            <li class="card group relative overflow-hidden p-7 transition-colors hover:border-brand/40" data-reveal>
              <span
                class="absolute -top-5 right-2 font-display text-8xl font-extrabold text-sand transition-colors group-hover:text-accent/25"
                aria-hidden="true"
              >
                {pillar.title[0]}
              </span>
              <span class="relative mb-5 inline-flex rounded-xl bg-brand p-3 text-white">
                <Icon name={pillar.icon} class="h-6 w-6" />
              </span>
              <h3 class="relative mb-2 text-lg">{pillar.title}</h3>
              <p class="relative leading-relaxed text-gray-600">{pillar.description}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Featured report -->
  {
    featuredReport && (
      <section class="section bg-sand">
        <div class="container-site">
          <div class="grid items-center gap-10 rounded-[2rem] bg-brand-deep p-8 md:p-12 lg:grid-cols-[1fr_1.4fr] lg:gap-16">
            {featuredReport.cover && (
              <div class="mx-auto w-full max-w-xs -rotate-3 overflow-hidden rounded-lg shadow-2xl transition-transform duration-500 hover:rotate-0">
                <Img media={featuredReport.cover} class="w-full" widths={[320, 640]} sizes="20rem" />
              </div>
            )}
            <div data-reveal>
              <p class="eyebrow mb-3 text-accent">
                <span class="h-px w-8 bg-accent" aria-hidden="true" />
                Latest annual report
              </p>
              <h2 class="text-3xl leading-tight text-white md:text-4xl">{featuredReport.title}</h2>
              {featuredReport.description && <p class="mt-4 text-lg text-white/85">{featuredReport.description}</p>}
              <div class="mt-8 flex flex-wrap gap-3">
                <a href={featuredReport.fileUrl} target="_blank" rel="noopener" class="btn-accent">
                  <Icon name="lucide:download" class="h-4 w-4" />
                  Download{featuredReport.fileSize && ` (${featuredReport.fileSize})`}
                </a>
                <a href="/reports" class="btn-outline-light">All reports</a>
              </div>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- Recognition -->
  <section class="section bg-white">
    <div class="container-site">
      <SectionHeading eyebrow="Recognition" title="Grassroots solutions on the global stage" centered />
      <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          recognitions.map((item) => (
            <li class="card p-6 text-center" data-reveal>
              <span class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-accent/20 text-accent-dark">
                <Icon name="lucide:trophy" class="h-7 w-7" />
              </span>
              <p class="text-sm font-bold tracking-wide text-brand uppercase">{item.title}</p>
              <h3 class="mt-2 text-lg">{item.award}</h3>
              <p class="mt-2 text-sm text-gray-500">
                {item.by} · {item.year}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- News -->
  {
    latestPosts.length > 0 && (
      <section class="section bg-sand">
        <div class="container-site">
          <div class="flex flex-wrap items-end justify-between gap-x-6">
            <SectionHeading eyebrow="News" title="Latest from the field" />
            <a href="/news" class="btn-outline mb-10 md:mb-14">
              All news <Icon name="lucide:arrow-right" class="h-4 w-4" />
            </a>
          </div>
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {latestPosts.map((post) => (
              <PostCard post={post} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Partners -->
  <section class="section bg-white">
    <div class="container-site">
      <SectionHeading
        eyebrow="Partners"
        title="Trusted by partners across Africa and the world"
        subtitle="Donors, institutions and civil society allies who make our work possible."
        centered
      />
      <PartnersStrip partners={partners} />
      <div class="mt-12 text-center">
        <a href="/contact?subject=Partnership" class="btn-primary">Become a partner</a>
      </div>
    </div>
  </section>
</BaseLayout>
