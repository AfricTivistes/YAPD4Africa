---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
---

<BaseLayout title="Message sent" noindex>
  <section class="section">
    <div class="container-site max-w-2xl text-center">
      <span class="mb-6 inline-flex rounded-full bg-emerald-100 p-4 text-brand">
        <Icon name="lucide:circle-check" class="h-12 w-12" />
      </span>
      <h1 class="mb-4 text-4xl text-gray-900">Thank you!</h1>
      <p class="mb-8 text-lg text-gray-600">
        Your message has been sent. A member of the YAPD4Africa team will get back to you soon.
      </p>
      <a href="/" class="btn-primary">Back to home</a>
    </div>
  </section>
</BaseLayout>
