---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { navigation } from "@/data/content";
---

<BaseLayout title="Page not found" noindex>
  <section class="section">
    <div class="container-site max-w-2xl text-center">
      <p class="mb-2 font-display text-6xl font-bold text-brand">404</p>
      <h1 class="mb-4 text-3xl text-gray-900">Page not found</h1>
      <p class="mb-8 text-lg text-gray-600">The page you are looking for doesn't exist or has been moved.</p>
      <a href="/" class="btn-primary">Return to home</a>
      <ul class="mt-10 flex flex-wrap justify-center gap-x-6 gap-y-2">
        {navigation.map((item) => <li><a href={item.href} class="inline-block py-1 font-medium text-brand hover:underline">{item.name}</a></li>)}
      </ul>
    </div>
  </section>
</BaseLayout>
