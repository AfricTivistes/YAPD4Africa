---
import type { GetStaticPaths } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Img from "@/components/Img.astro";
import Icon from "@/components/Icon.astro";
import { formatDate, getPosts } from "@/lib/content";
import type { Post } from "@/lib/types";
import { SITE_NAME } from "@/data/content";

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  // Posts pointing to an external article have no page on this site.
  return posts.filter((post) => !post.externalUrl).map((post) => ({ params: { slug: post.slug }, props: { post } }));
}) satisfies GetStaticPaths;

interface Props {
  post: Post;
}

const { post } = Astro.props;
const site = Astro.site!;
const url = new URL(`/news/${post.slug}`, site).href;
const article = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  headline: post.title,
  description: post.excerpt,
  datePublished: post.date,
  mainEntityOfPage: url,
  image: typeof post.image?.src === "string" ? [post.image.src] : undefined,
  author: { "@id": new URL("/#organization", site).href },
  publisher: { "@id": new URL("/#organization", site).href },
};
const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", site).href },
    { "@type": "ListItem", position: 2, name: "News", item: new URL("/news", site).href },
    { "@type": "ListItem", position: 3, name: post.title },
  ],
};
---

<BaseLayout
  title={post.title}
  fullTitle={post.seo?.title}
  description={post.seo?.description || post.excerpt}
  image={post.image?.src}
  type="article"
  publishedTime={post.date}
  jsonLd={[article, breadcrumb]}
>
  <article class="section">
    <div class="container-site max-w-3xl">
      <nav aria-label="Breadcrumb" class="mb-6 text-sm text-gray-500">
        <a href="/news" class="inline-flex items-center gap-1 py-1 hover:text-brand">
          <Icon name="lucide:arrow-left" class="h-4 w-4" /> All news
        </a>
      </nav>
      <time datetime={post.date} class="text-sm font-medium tracking-wide text-brand uppercase">{formatDate(post.date)}</time>
      <h1 class="mt-2 mb-8 text-3xl text-gray-900 md:text-5xl">{post.title}</h1>
      {
        post.image && (
          <div class="mb-10 overflow-hidden rounded-2xl shadow-lg">
            <Img media={post.image} class="w-full" widths={[640, 1024, 1536]} sizes="(min-width: 768px) 768px, 100vw" loading="eager" />
          </div>
        )
      }
      <div class="prose prose-lg max-w-none prose-headings:font-display prose-a:text-brand prose-img:rounded-xl" set:html={post.content} />
      <p class="mt-12 border-t border-gray-100 pt-6 text-gray-600">
        Published by {SITE_NAME}. <a href="/contact" class="inline-block py-1 font-semibold text-brand">Get in touch</a> to learn more.
      </p>
    </div>
  </article>
</BaseLayout>
