---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import PersonCard from "@/components/PersonCard.astro";
import CtaBand from "@/components/CtaBand.astro";
import hero from "@/assets/images/home/hero.png";
import founder from "@/assets/images/staff/idris-bilyaminu.jpg";
import { getPeople } from "@/lib/content";
import { coreValues, founderQuote, timeline } from "@/data/content";

const [staff, trustees] = await Promise.all([getPeople("staff"), getPeople("trustee")]);
---

<BaseLayout
  title="Who We Are: Our Story, Team and Board of Trustees"
  description="Founded in 2017, YAPD4Africa is a Pan-African youth-led organization. Meet the team and Board of Trustees transforming grassroots communities across Africa."
  image={hero}
>
  <PageHero
    eyebrow="Who we are"
    title="Young Africans building accountable communities"
    intro="Meet our brilliant and inspiring team of changemakers dedicated to transforming communities across Africa through youth-led initiatives and sustainable development."
    image={{ src: hero, alt: "YAPD4Africa team members with community elders" }}
  />

  <section class="section bg-white">
    <div class="container-site grid items-center gap-16 lg:grid-cols-2">
      <div>
        <SectionHeading eyebrow="Our story" title="Born from the grassroots, built by young Africans" />
        <div class="space-y-6 text-lg leading-relaxed text-gray-700" data-reveal>
          <p>
            YAPD4Africa was founded in 2017 by a group of passionate young Africans who believed in the power of
            youth-led initiatives to address pressing social challenges. What began as a small network of volunteers
            has grown into a prominent organization with programs in multiple African countries.
          </p>
          <p>
            Our founders recognized that despite Africa being the continent with the youngest population, young people
            were often excluded from development processes and decision-making. They established YAPD4Africa to bridge
            this gap, creating platforms for youth leadership and meaningful participation in community development.
          </p>
          <p>
            Officially registered with the Corporate Affairs Commission in 2024 and headquartered in Kaduna, YAPD4Africa
            now runs programs in Nigeria and Cameroon, with expansion underway in Ghana and Kenya.
          </p>
        </div>
      </div>
      <figure class="relative overflow-hidden rounded-3xl shadow-2xl" data-reveal>
        <Image
          src={founder}
          alt="Idris Bilyaminu Ndasadu'Lau, founder of YAPD4Africa"
          class="aspect-[4/5] w-full object-cover object-top"
          width={800}
          widths={[480, 800]}
          sizes="(min-width: 1024px) 50vw, 100vw"
        />
        <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-emerald-950/80 to-transparent p-8 text-white">
          <p class="font-display text-2xl font-bold">Idris Bilyaminu Ndasadu'Lau</p>
          <p class="text-white/90">Founder & Chief Executive</p>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section bg-brand-deep">
    <div class="container-site grid gap-12 lg:grid-cols-[1fr_1.4fr] lg:gap-20">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <SectionHeading
          eyebrow="Our journey"
          title="From a volunteer network to a Pan-African movement"
          subtitle="Key milestones since 2017."
          inverted
        />
        <figure class="hidden border-l-4 border-accent pl-6 lg:block" data-reveal>
          <blockquote class="font-display text-xl leading-snug font-semibold text-white">“{founderQuote.text}”</blockquote>
          <figcaption class="mt-3 text-sm text-white/70">{founderQuote.author}, {founderQuote.role}</figcaption>
        </figure>
      </div>
      <ol class="relative space-y-8 border-l-2 border-white/15 pl-8">
        {
          timeline.map((step) => (
            <li class="relative" data-reveal>
              <span
                class="absolute top-1 -left-[2.6rem] flex h-5 w-5 items-center justify-center rounded-full border-4 border-brand-deep bg-accent"
                aria-hidden="true"
              />
              <p class="font-display text-2xl font-bold text-accent">{step.year}</p>
              <p class="mt-1 text-lg leading-relaxed text-white/85">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-site">
      <SectionHeading eyebrow="What guides us" title="Core Values" subtitle="The principles that drive our impact" centered />
      <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          coreValues.map((value) => (
            <li class="group relative overflow-hidden rounded-2xl shadow-lg" data-reveal>
              <Image
                src={value.image}
                alt=""
                class="h-64 w-full object-cover transition-transform duration-500 group-hover:scale-110"
                width={700}
                widths={[400, 700]}
                sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
              />
              <div class="absolute inset-0 flex flex-col justify-end bg-gradient-to-t from-black/90 via-black/50 to-transparent p-6">
                <h3 class="mb-2 text-xl text-white">{value.title}</h3>
                <p class="text-sm text-white/90">{value.description}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section bg-sand">
    <div class="container-site">
      <SectionHeading eyebrow="Our team" title="The people behind our impact" subtitle="A dedicated team of 10 full-time staff, working in the field and remotely." centered />
      <ul class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {staff.map((person) => <PersonCard person={person} />)}
      </ul>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-site">
      <SectionHeading
        eyebrow="Governance"
        title="Board of Trustees"
        subtitle="A diverse group of experts from across Nigeria's geopolitical zones and Africa"
        centered
      />
      <ul class="grid grid-cols-2 gap-4 sm:gap-6 lg:grid-cols-4">
        {trustees.map((person) => <PersonCard person={person} compact />)}
      </ul>
    </div>
  </section>

  <CtaBand
    title="Join Our Team"
    text="Interested in contributing your skills and passion to YAPD4Africa's mission? Get in touch to join our team or volunteer with us."
    label="Contact Us"
    href="/contact"
  />
</BaseLayout>
