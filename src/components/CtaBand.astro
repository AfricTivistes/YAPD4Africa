---
interface Props {
  title: string;
  text: string;
  href?: string;
  label: string;
}

const { title, text, href = "/support-us", label } = Astro.props;
---

<section class="bg-white py-16 md:py-20">
  <div class="container-site">
    <div
      class="relative overflow-hidden rounded-[2rem] bg-brand-deep px-6 py-14 text-center md:px-12 md:py-16"
      data-reveal
    >
      <div class="pointer-events-none absolute -top-24 -left-24 h-64 w-64 rounded-full bg-brand/40 blur-3xl" aria-hidden="true">
      </div>
      <div class="pointer-events-none absolute -right-24 -bottom-24 h-64 w-64 rounded-full bg-accent/25 blur-3xl" aria-hidden="true">
      </div>
      <div class="relative mx-auto max-w-2xl">
        <h2 class="mb-4 text-3xl text-white md:text-4xl">{title}</h2>
        <p class="mb-8 text-lg text-white/80">{text}</p>
        <a href={href} class="btn-accent px-8 py-4 text-lg">{label}</a>
      </div>
    </div>
  </div>
</section>
