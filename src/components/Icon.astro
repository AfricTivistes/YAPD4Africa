---
// Renders an Iconify icon as inline SVG at build time (no client JS).
// Usage: <Icon name="lucide:mail" class="h-5 w-5" />
import lucide from "@iconify-json/lucide/icons.json";
import brands from "@iconify-json/fa6-brands/icons.json";

interface IconSet {
  width?: number;
  height?: number;
  icons: Record<string, { body: string; width?: number; height?: number }>;
}

interface Props {
  name: `lucide:${string}` | `fa6-brands:${string}`;
  class?: string;
  label?: string;
}

const sets: Record<string, IconSet> = { lucide, "fa6-brands": brands };
const { name, class: className = "h-5 w-5", label } = Astro.props;
const [prefix, iconName] = name.split(":");
const set = sets[prefix];
const icon = set?.icons[iconName];
if (!icon) throw new Error(`Unknown icon: ${name}`);
const width = icon.width ?? set.width ?? 16;
const height = icon.height ?? set.height ?? 16;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={`0 0 ${width} ${height}`}
  class={className}
  fill="currentColor"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  set:html={icon.body}
/>
