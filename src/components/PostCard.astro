---
import Img from "./Img.astro";
import Icon from "./Icon.astro";
import { formatDate, postHref } from "@/lib/content";
import type { Post } from "@/lib/types";

interface Props {
  post: Post;
  headingLevel?: "h2" | "h3";
}

const { post, headingLevel: Heading = "h3" } = Astro.props;
const external = Boolean(post.externalUrl);
---

<article
  class="card group relative flex w-full flex-col overflow-hidden transition-all duration-300 hover:-translate-y-1 hover:shadow-xl"
  data-reveal
>
  {
    post.image && (
      <div class="aspect-[16/9] overflow-hidden">
        <Img
          media={post.image}
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
          widths={[400, 800]}
          sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
        />
      </div>
    )
  }
  <div class="flex flex-1 flex-col p-6">
    <time datetime={post.date} class="mb-2 text-sm font-semibold tracking-wide text-accent-dark uppercase">
      {formatDate(post.date)}
    </time>
    <Heading class="mb-3 text-xl group-hover:text-brand">
      <a
        href={postHref(post)}
        class="after:absolute after:inset-0"
        {...external ? { target: "_blank", rel: "noopener noreferrer" } : {}}
      >
        {post.title}
      </a>
    </Heading>
    <p class="mb-6 line-clamp-4 text-gray-600">{post.excerpt}</p>
    <span class="mt-auto inline-flex items-center gap-2 font-semibold text-brand">
      {external ? "Read article" : "Read more"}
      <Icon name={external ? "lucide:arrow-up-right" : "lucide:arrow-right"} class="h-4 w-4" />
    </span>
  </div>
</article>
