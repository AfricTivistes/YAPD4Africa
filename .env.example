# WordPress REST API base (no trailing slash).
# Leave empty to build the site from the local fallback data in src/data/.
# If WordPress is unreachable during a build, the local data is used and the build still succeeds.
WP_API_URL=https://cms.yapd4africa.org/wp-json/wp/v2

# Optional - audience measurement (pick one). Plausible is cookie-free (no consent banner needed).
PUBLIC_PLAUSIBLE_DOMAIN=
PUBLIC_GA_ID=

# Optional - Google Search Console "HTML tag" verification code (content of the meta tag only).
PUBLIC_GOOGLE_SITE_VERIFICATION=
